{
  "name": "workflow-automation-platform",
  "version": "1.0.0",
  "description": "A workflow automation platform similar to n8n",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage",
    "db:create": "node scripts/create-database.js",
    "db:setup": "npm run db:create",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-database.js",
    "db:test": "node scripts/test-connection.js",
    "check:db": "node scripts/test-connection.js",
    "check:redis": "node scripts/test-redis.js",
    "check:health": "curl -f http://localhost:3000/health || echo 'Server not running'",
    "status": "npm run check:db && npm run check:redis && npm run check:health"
  },
  "keywords": [
    "workflow",
    "automation",
    "n8n",
    "integration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.17.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@octokit/rest": "^22.0.0",
    "@slack/web-api": "^7.10.0",
    "@slack/webhook": "^7.0.6",
    "@types/jsonpath": "^0.2.4",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.2",
    "@types/redis": "^4.0.11",
    "ajv": "^8.17.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.3.1",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "fast-json-stringify": "^6.0.1",
    "googleapis": "^157.0.0",
    "handlebars": "^4.7.8",
    "html-pdf-node": "^1.0.8",
    "image-size": "^2.0.2",
    "joi": "^17.13.3",
