    "jsonpath": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "mathjs": "^14.6.0",
    "moment": "^2.30.1",
    "mongodb": "^6.18.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3",
    "puppeteer": "^24.17.0",
    "redis": "^4.7.1",
