{
  "name": "workflow-automation-platform",
  "version": "1.0.0",
  "description": "A workflow automation platform similar to n8n",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage",
    "db:create": "node scripts/create-database.js",
    "db:setup": "npm run db:create",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-database.js",
    "db:test": "node scripts/test-connection.js",
    "check:db": "node scripts/test-connection.js",
    "check:redis": "node scripts/test-redis.js",
    "check:health": "curl -f http://localhost:3000/health || echo 'Server not running'",
    "status": "npm run check:db && npm run check:redis && npm run check:health"
  },
  "keywords": [
    "workflow",
    "automation",
    "n8n",
    "integration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/jsonpath": "^0.2.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonpath": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mysql2": "^3.14.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8",
    "papaparse": "^5.5.3",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "sequelize": "^6.35.0",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.4",
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.10",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.9",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  }
}
