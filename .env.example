# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_automation
DB_USER=postgres
DB_PASSWORD=postgres

# For production, consider using connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# For Redis Cluster (optional)
# REDIS_CLUSTER=false
# REDIS_CLUSTER_NODES=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# IMPORTANT: Change these in production!
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars

# Token expiration times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# WEBHOOK CONFIGURATION
# ===========================================
WEBHOOK_BASE_URL=http://localhost:3000

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email addresses
EMAIL_FROM="Workflow Platform <noreply@yourcompany.com>"
EMAIL_REPLY_TO=support@yourcompany.com

# Email templates
EMAIL_VERIFY_URL=http://localhost:3001/verify-email
EMAIL_RESET_URL=http://localhost:3001/reset-password

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE=50mb

# Log configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10mb
LOG_MAX_FILES=5

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Session timeout (in milliseconds)
SESSION_TIMEOUT=900000

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800000

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# ===========================================
# WORKFLOW EXECUTION
# ===========================================
# Execution limits
MAX_EXECUTION_TIME=300000
EXECUTION_TIMEOUT=60000
MAX_CONCURRENT_EXECUTIONS=100

# Node execution
NODE_RETRY_ATTEMPTS=3
NODE_RETRY_DELAY=1000
NODE_TIMEOUT=30000

# Queue settings
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=50

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
MONITORING_ENABLED=true
MONITORING_RETENTION_DAYS=30
MONITORING_BUFFER_SIZE=100
MONITORING_FLUSH_INTERVAL=5000

# Metrics collection
METRICS_ENABLED=true
METRICS_INTERVAL=60000

# Alerting
ALERT_EMAIL_ENABLED=true
ALERT_WEBHOOK_ENABLED=false
ALERT_SLACK_ENABLED=false

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=20
ALERT_EXECUTION_TIMEOUT=600000
ALERT_MEMORY_THRESHOLD=80

# ===========================================
# EXTERNAL SERVICES (Optional)
# ===========================================
# Slack integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-workflow-bucket

# SendGrid (for emails)
SENDGRID_API_KEY=your-sendgrid-api-key

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ===========================================
# DEVELOPMENT OPTIONS
# ===========================================
# Debug settings
DEBUG=false
DEBUG_SQL=false
DEBUG_REDIS=false

# Development features
HOT_RELOAD=true
CORS_ALLOW_ALL=false
DISABLE_AUTH=false

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# ===========================================
# PERFORMANCE TUNING
# ===========================================
# Node.js settings
NODE_OPTIONS=--max-old-space-size=2048

# Database connection pool
DB_CONNECTION_TIMEOUT=60000
DB_IDLE_TIMEOUT=10000

# Redis connection pool
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000

# HTTP settings
HTTP_TIMEOUT=30000
HTTP_KEEP_ALIVE=true

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Security headers
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Clustering
CLUSTER_WORKERS=0

# Health checks
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
# Database backups
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# ===========================================
# FEATURE FLAGS
# ===========================================
# Feature toggles
FEATURE_WORKFLOW_TEMPLATES=true
FEATURE_AI_SUGGESTIONS=false
FEATURE_ADVANCED_SCHEDULING=true
FEATURE_WORKFLOW_VERSIONING=false
FEATURE_MARKETPLACE=false

# ===========================================
# THIRD-PARTY INTEGRATIONS
# ===========================================
# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# GitHub (for version control integration)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (for authentication)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret