# gitignore for node and react project
# Logs
logs
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.pnpm-debug.log

# Logs
logs/
*.log
logs/**/*.log
*.out
*.err
npm-debug.log*
yarn-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Compiled binary addons (node-gyp)
build/Release

# Dependency directories
jspm_packages/

# Optional eslint cache
.eslintcache

# dotenv environment variables
.env
.env.*.local

# Cache
.cache/
.next/
.nuxt/
out/
dist/
tmp/
temp/

# TypeScript
*.tsbuildinfo

# VSCode / IDE
.vscode/
.idea/
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db

# React build
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.cache/
frontend/dist/

# Docker
*.pid
*.pid.lock
docker-data/

# Redis
redis/
redis.zip

# Misc
archives/
backups/
storage/
.claude/